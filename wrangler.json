{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lingua-studio",
  "main": "src/worker.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "."
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lingua_studio_db",
